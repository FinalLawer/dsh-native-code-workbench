node_modules/
**/node_modules/
__pycache__/
*.pyc
tmp-*.txt
.DS_Store

# Packaged release artifacts (tarball / zip produced by `npm pack`), captured
# run logs, and the local cleanup quarantine under `outputs/_trash-*/`.
outputs/

# Scratch diagnostics live under a leading underscore: one-off probes and
# fault-injection scripts kept locally to reproduce a measurement. They are not
# part of the suite and never ship.
tools/_*

# Reference material unpacked from the installed desktop client — the whole
# tree, its node_modules included. Kept locally for API lookups, but it is not
# ours to redistribute: the Electron shell (main process, preload scripts, and
# renderer documents) is not part of the MIT-licensed `@deepseek-ai/dsh` package
# published on npm. Nothing under it is tracked, so the tree is ignored whole
# rather than file by file — a freshly unpacked copy cannot leak into a commit.
ref/
