{
  "name": "dsh-code-workbench",
  "description": "Code Workbench for the DSH Web GUI: Monaco (the VS Code editor core) over workspace files in the right sidebar, with a version-guarded save path",
  "version": "0.5.4",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "node build.mjs",
    "build:vendor": "esbuild node_modules/@deepseek-ai/schemastery/lib/index.mjs --bundle --format=esm --outfile=vendor/schemastery.mjs --legal-comments=eof",
    "test": "node ../tools/test-client-contract.mjs && node ../tools/test-host-write.mjs && node ../tools/test-file-operations.mjs && node ../tools/test-host-search.mjs && node ../tools/test-host-tool.mjs && node ../tools/test-host-complete.mjs && node ../tools/test-completion-api.mjs && node ../tools/test-host-history.mjs && node ../tools/test-bundle-slim.mjs && node ../tools/test-client-smoke.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "completion-api.mjs",
    "client.js",
    "src",
    "vendor",
    "build.mjs",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "monaco",
    "editor",
    "workspace",
    "code-completion",
    "fim"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FinalLawer/dsh-native-code-workbench.git",
    "directory": "dsh-code-workbench"
  },
  "homepage": "https://github.com/FinalLawer/dsh-native-code-workbench/tree/master/dsh-code-workbench",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-util-workspace-path": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "esbuild": "^0.28.2",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-test-renderer": "^19.3.0"
  }
}
